{
  "name": "app-corrida-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gera e ajusta planos de corrida com a Claude API para o Fast run.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@hono/node-server": "1.19.5",
    "firebase-admin": "14.4.0",
    "hono": "4.10.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
